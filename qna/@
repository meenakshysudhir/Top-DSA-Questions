#include <everything.h>
using namespace std;

bool check3by3(vector<vector<char>> board, int row, int col) {
  unordered_set<char> set;
  int count = 0;
  for (int i = row; i < row + 3; i++) {
    for (int j = col; j < col + 3; j++) {
      if (board[i][j] != '.') {
        set.insert(board[i][j]);
        count++;
      }
    }
  }
  if (count != set.size()) {
    return false;
  }
  return true;
}
int main(void) {
  vector<vector<char>> board = {
      {'1', '2', '.', '.', '3', '.', '.', '.', '.'},
      {'4', '.', '.', '5', '.', '.', '.', '.', '.'},
      {'.', '9', '8', '.', '.', '.', '.', '.', '3'},
      {'5', '.', '.', '.', '6', '.', '.', '.', '4'},
      {'.', '.', '.', '8', '.', '3', '.', '.', '5'},
      {'7', '.', '.', '.', '2', '.', '.', '.', '6'},
      {'.', '.', '.', '.', '.', '.', '2', '.', '.'},
      {'.', '.', '.', '4', '1', '9', '.', '.', '8'},
      {'.', '.', '.', '.', '8', '.', '.', '7', '9'},

  };
  int row = 0, col = 0, flag;
  while (flag = check3by3(board, row, col)) {
    if (col != 6) {
      col += 3;
    } else {
      if (row != 6) {
        row += 3;
        col = 0;
      }
    }
  }

  cout << flag << endl;
}
