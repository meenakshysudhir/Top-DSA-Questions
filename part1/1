#include <iostream>
using namespace std;

int pallindrome(int n,string& s){
    if(n >= s.length()){
        return 1;
    }
    if(s[n] != s[s.length() - 1 - n]){
        return 0;
    }
    return pallindrome(n++,s);
}
int main()
{
    cout << "Enter the word : ";
    string s;
    cin >> s;
    int res = pallindrome(0,s);
    (res == 0) ? cout << "Not a pallindrome" << endl : cout << "Word is pallindrom\n";
    return 0;
}
